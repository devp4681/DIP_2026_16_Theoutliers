def predict_query_labels(S_visual, L_gallery, k=5, mode="hard", threshold=0.5, exclude_mask=None):
    """
    Predicts multi-label vector for queries using top-k gallery visual neighbors.

    Args:
        S_visual: (n_queries, n_gallery) array of visual retrieval similarity scores.
        L_gallery: (n_gallery, 17) array of ground-truth gallery multi-labels.
        k: number of nearest neighbors for voting.
        mode: "hard" (binary indicator based on threshold) or "soft" (continuous vote fraction).
        threshold: voting fraction threshold for hard mode.
        exclude_mask: boolean mask (n_queries, n_gallery) where True indicates self-matches to exclude.

    Returns:
        L_pred: (n_queries, 17) array of predicted labels (binary for hard, continuous for soft).
        vote_fracs: (n_queries, 17) continuous array of neighbor vote fractions.
    """
    S_clean = S_visual.copy()
    if exclude_mask is not None and np.any(exclude_mask):
        S_clean[exclude_mask] = -np.inf

    # Top-k nearest visual neighbors (descending similarity)
    order = np.argsort(-S_clean, axis=1, kind="stable")
    top_k_indices = order[:, :k]  # shape: (n_queries, k)

    # Gather neighbor labels: shape (n_queries, k, 17)
    neighbor_labels = L_gallery[top_k_indices]
    vote_fracs = neighbor_labels.mean(axis=1)  # shape: (n_queries, 17)

    if mode == "soft":
        L_pred = vote_fracs.copy()
    else:
        L_pred = (vote_fracs >= threshold).astype(np.float64)

    return L_pred, vote_fracs


def compute_continuous_jaccard(U, V):
    """
    Pairwise continuous / generalized Jaccard (Ruzicka similarity) between
    query label representations U (n_q, 17) and binary gallery labels V (n_g, 17).

    Formula:
        Jaccard(u, v) = sum(min(u, v)) / sum(max(u, v))
    When V is binary {0, 1}:
        sum(min(u, v)) = u @ v.T
        sum(max(u, v)) = sum(u) + sum(v) - u @ v.T
    When U is also binary, this collapses exactly to standard Jaccard.
    Handles zero vectors safely (returns 0.0). Guaranteed in [0.0, 1.0].
    """
    inter = U @ V.T
    sum_u = U.sum(axis=1)[:, None]
    sum_v = V.sum(axis=1)[None, :]
    union = sum_u + sum_v - inter
    return np.divide(inter, union, out=np.zeros_like(inter, dtype=np.float64), where=union > 0)


def evaluate_grid(out_dir, dataset=None):
    if dataset is None:
        dataset = CVDataset()

    print("=" * 110)
    print("RUNNING V3 + LABEL CONTEXT V2 EXPERIMENT (FULLY DATA-DRIVEN & COMPREHENSIVE)")
    print(f"Lambdas: {LAMBDAS}")
    print(f"k values: {K_VALUES} | Thresholds: {THRESHOLDS} | Modes: ['hard', 'soft'] + ORACLE")
    print("=" * 110)

    # Define all model configurations:
    # 1. Hard voting: (mode='hard', k=k, threshold=th) -> 3 x 3 = 9 configs
    # 2. Soft voting: (mode='soft', k=k, threshold=None) -> 3 configs
    model_configs = []
    for k in K_VALUES:
        for th in THRESHOLDS:
            model_configs.append({
                "config_id": f"hard_k{k}_th{th:.1f}",
                "mode": "hard",
                "k": k,
                "threshold": th,
                "is_oracle": False
            })
    for k in K_VALUES:
        model_configs.append({
            "config_id": f"soft_k{k}",
            "mode": "soft",
            "k": k,
            "threshold": np.nan,
            "is_oracle": False
        })

    # Diagnostic Oracle configuration
    oracle_config = {
        "config_id": "oracle_gt",
        "mode": "oracle",
        "k": 0,
        "threshold": np.nan,
        "is_oracle": True
    }

    all_configs_to_run = model_configs + [oracle_config]

    # Precompute visual scores and label similarities per fold
    print("\n[Step 1] Precomputing V3 visual scores and label similarity matrices for all folds...")
    fold_data_store = []

    for fold_i in range(5):
        fd = dataset.get_fold_data(fold_i)

        # Compute frozen V3 visual similarity
        sims = compute_fold_sims(fd, V3_SIM_FNS)
        S_v3 = sum(V3_WEIGHTS[c] * sims[c] for c in V3_WEIGHTS)

        if fd["exclude_mask"] is not None and np.any(fd["exclude_mask"]):
            S_v3[fd["exclude_mask"]] = -np.inf

        L_g = dataset.labels[fd["g_idx"]]
        L_q_gt = dataset.labels[fd["q_idx"]]

        # Compute V3 baseline metrics (lambda = 0.0)
        v3_metrics = evaluate_ranking(
            S_v3, fd["q_cls"], fd["g_cls"], fd["J_mat"],
            exclude_mask=fd["exclude_mask"]
        )

        # Precompute label similarities for every config
        config_sims = {}
        for cfg in all_configs_to_run:
            cid = cfg["config_id"]
            if cfg["is_oracle"]:
                # ORACLE: uses true query labels
                label_sim = compute_continuous_jaccard(L_q_gt, L_g)
            else:
                L_pred, _ = predict_query_labels(
                    S_v3, L_g, k=cfg["k"], mode=cfg["mode"],
                    threshold=cfg["threshold"] if not np.isnan(cfg["threshold"]) else 0.5,
                    exclude_mask=fd["exclude_mask"]
                )
                label_sim = compute_continuous_jaccard(L_pred, L_g)

            # Sanity check bounded similarity
            assert label_sim.min() >= 0.0 and label_sim.max() <= 1.0, f"Label sim out of bounds in {cid}!"
            config_sims[cid] = label_sim

        fold_data_store.append({
            "fold_i": fold_i,
            "fd": fd,
            "S_v3": S_v3,
            "v3_metrics": v3_metrics,
            "config_sims": config_sims
        })
        print(f"Fold {fold_i + 1} ready. V3 Selection Score: {v3_metrics['selection_score']:.4f} | "
              f"Class P@10: {v3_metrics['Class P@10']:.4f}")

    # Evaluate full grid
    print("\n[Step 2] Evaluating retrieval across all configurations and lambda values...")
    grid_records = []

    for fold_i in range(5):
        f_store = fold_data_store[fold_i]
        fd = f_store["fd"]
        S_v3 = f_store["S_v3"]

        for cfg in all_configs_to_run:
            cid = cfg["config_id"]
            sim_mat = f_store["config_sims"][cid]

            # 1. Lambda sweep
            for lam in LAMBDAS:
                S_final = S_v3 + lam * sim_mat
                m = evaluate_ranking(
                    S_final, fd["q_cls"], fd["g_cls"], fd["J_mat"],
                    exclude_mask=fd["exclude_mask"]
                )
                grid_records.append({
                    "fold": fold_i + 1,
                    "config_id": cid,
                    "mode": cfg["mode"],
                    "k": cfg["k"],
                    "threshold": cfg["threshold"],
                    "is_oracle": cfg["is_oracle"],
                    "is_label_only": False,
                    "lambda": lam,
                    **m
                })

            # 2. Label-Only baseline (lambda -> infinity)
            S_label_only = sim_mat.copy()
            m_lo = evaluate_ranking(
                S_label_only, fd["q_cls"], fd["g_cls"], fd["J_mat"],
                exclude_mask=fd["exclude_mask"]
            )
            grid_records.append({
                "fold": fold_i + 1,
                "config_id": cid,
                "mode": cfg["mode"],
                "k": cfg["k"],
                "threshold": cfg["threshold"],
                "is_oracle": cfg["is_oracle"],
                "is_label_only": True,
                "lambda": np.inf,
                **m_lo
            })

    df_results = pd.DataFrame(grid_records)
    df_results.to_csv(out_dir / "label_context_v2_results.csv", index=False)
    print(f"Saved complete grid evaluation ({len(df_results)} rows) to: {out_dir / 'label_context_v2_results.csv'}")

    # Verification: Lambda = 0 reproduces V3 within tolerance (no hardcoded string assertion)
    df_lam0 = df_results[(df_results["lambda"] == 0.0) & (~df_results["is_label_only"])]
    mean_lam0_sel = df_lam0["selection_score"].mean()
    mean_v3_sel = np.mean([f["v3_metrics"]["selection_score"] for f in fold_data_store])
    print(f"\n[Sanity Check] Lambda=0 Selection: {mean_lam0_sel:.4f} vs V3 Baseline: {mean_v3_sel:.4f}")
    assert np.isclose(mean_lam0_sel, mean_v3_sel, atol=1e-4), "Sanity check failed: lambda=0 does not match V3!"
    print("Sanity Check PASSED: Lambda=0 exactly reproduces V3 within 1e-4 tolerance.")

    return df_results


def compute_and_save_summaries(df_results, out_dir, start_time):
    # 3. Create Lambda Trade-off CSV & Analysis
    print("\n[Step 3] Generating lambda trade-off table and curves...")
    df_non_lo = df_results[~df_results["is_label_only"]]

    tradeoff_records = []
    tradeoff_configs = [
        "hard_k5_th0.5",  # Primary standard baseline from v1
        "soft_k5",        # Primary soft voting candidate
        "hard_k3_th0.5",
        "hard_k7_th0.5",
        "oracle_gt"       # Diagnostic ceiling
    ]

    for cid in tradeoff_configs:
        sub = df_non_lo[df_non_lo["config_id"] == cid]
        for lam in LAMBDAS:
            lam_sub = sub[sub["lambda"] == lam]
            tradeoff_records.append({
                "config_id": cid,
                "lambda": lam,
                "Class P@10_mean": lam_sub["Class P@10"].mean(),
                "Class P@10_std": lam_sub["Class P@10"].std(),
                "ML P@10_mean": lam_sub["ML P@10"].mean(),
                "ML P@10_std": lam_sub["ML P@10"].std(),
                "ML mAP_mean": lam_sub["ML mAP"].mean(),
                "ML mAP_std": lam_sub["ML mAP"].std(),
                "nDCG@10_mean": lam_sub["nDCG@10"].mean(),
                "nDCG@10_std": lam_sub["nDCG@10"].std(),
                "selection_score_mean": lam_sub["selection_score"].mean(),
                "selection_score_std": lam_sub["selection_score"].std(),
            })

    df_tradeoff = pd.DataFrame(tradeoff_records)
    df_tradeoff.to_csv(out_dir / "lambda_tradeoff.csv", index=False)
    print(f"Saved lambda trade-off data to: {out_dir / 'lambda_tradeoff.csv'}")

    # Print trade-off table for hard_k5_th0.5, soft_k5, and oracle_gt
    for display_cid in ["hard_k5_th0.5", "soft_k5", "oracle_gt"]:
        print("\n" + "=" * 90)
        print(f"TRADE-OFF TABLE ACROSS LAMBDAS: {display_cid.upper()}")
        print("=" * 90)
        print(f"{'Lambda':<8} {'Class P@10':<18} {'ML mAP':<18} {'ML P@10':<18} {'Selection Score':<18}")
        print("-" * 90)
        t_sub = df_tradeoff[df_tradeoff["config_id"] == display_cid]
        for _, row in t_sub.iterrows():
            print(f"{row['lambda']:<8.2f} "
                  f"{row['Class P@10_mean']:.4f} +/- {row['Class P@10_std']:.4f}  "
                  f"{row['ML mAP_mean']:.4f} +/- {row['ML mAP_std']:.4f}  "
                  f"{row['ML P@10_mean']:.4f} +/- {row['ML P@10_std']:.4f}  "
                  f"{row['selection_score_mean']:.4f} +/- {row['selection_score_std']:.4f}")

    # 4. Strict Leave-One-Fold-Out (LOFO) Model Selection
    print("\n[Step 4] Running Leave-One-Fold-Out (LOFO) parameter selection across 3 objective strategies...")
    df_candidates = df_results[(~df_results["is_oracle"]) & (~df_results["is_label_only"])]

    lofo_selections = {"fold_results": {}}
    per_fold_comparison_rows = []

    for test_fold in range(1, 6):
        train_folds = [f for f in range(1, 6) if f != test_fold]
        df_train = df_candidates[df_candidates["fold"].isin(train_folds)]

        # Group by candidate parameter tuple: (config_id, lambda)
        train_agg = df_train.groupby(["config_id", "mode", "k", "threshold", "lambda"], dropna=False).agg(
            train_sel=("selection_score", "mean"),
            train_class=("Class P@10", "mean"),
            train_ml_map=("ML mAP", "mean")
        ).reset_index()

        train_agg["train_balanced"] = 0.5 * train_agg["train_class"] + 0.5 * train_agg["train_sel"]

        # 1. Selection Optimal
        best_sel_row = train_agg.sort_values(by=["train_sel", "train_class"], ascending=False).iloc[0]

        # 2. Visual Optimal
        best_vis_row = train_agg.sort_values(by=["train_class", "train_sel"], ascending=False).iloc[0]

        # 3. Balanced Optimal
        best_bal_row = train_agg.sort_values(by=["train_balanced", "train_class"], ascending=False).iloc[0]

        # Evaluate on the untouched held-out fold
        df_held = df_results[df_results["fold"] == test_fold]

        # V3 baseline on held-out fold
        v3_held = df_held[(df_held["lambda"] == 0.0) & (~df_held["is_label_only"])].iloc[0]

        # Held-out metrics for the selected strategies
        def get_held_metrics(cfg_id, lam):
            return df_held[(df_held["config_id"] == cfg_id) & (df_held["lambda"] == lam) & (~df_held["is_label_only"])].iloc[0]

        m_sel = get_held_metrics(best_sel_row["config_id"], best_sel_row["lambda"])
        m_vis = get_held_metrics(best_vis_row["config_id"], best_vis_row["lambda"])
        m_bal = get_held_metrics(best_bal_row["config_id"], best_bal_row["lambda"])

        # Label-Only for the selection-optimal config
        m_lo = df_held[(df_held["config_id"] == best_sel_row["config_id"]) & (df_held["is_label_only"])].iloc[0]

        # Oracle at lambda=0.5 and Oracle Label-Only
        m_oracle_05 = df_held[(df_held["config_id"] == "oracle_gt") & (df_held["lambda"] == 0.50) & (~df_held["is_label_only"])].iloc[0]
        m_oracle_lo = df_held[(df_held["config_id"] == "oracle_gt") & (df_held["is_label_only"])].iloc[0]

        lofo_selections["fold_results"][f"fold_{test_fold}"] = {
            "train_folds": train_folds,
            "strategy_sel_optimal": {
                "config_id": best_sel_row["config_id"],
                "lambda": float(best_sel_row["lambda"]),
                "train_selection_score": float(best_sel_row["train_sel"]),
                "train_class_p10": float(best_sel_row["train_class"])
            },
            "strategy_visual_optimal": {
                "config_id": best_vis_row["config_id"],
                "lambda": float(best_vis_row["lambda"]),
                "train_selection_score": float(best_vis_row["train_sel"]),
                "train_class_p10": float(best_vis_row["train_class"])
            },
            "strategy_balanced_optimal": {
                "config_id": best_bal_row["config_id"],
                "lambda": float(best_bal_row["lambda"]),
                "train_selection_score": float(best_bal_row["train_sel"]),
                "train_class_p10": float(best_bal_row["train_class"])
            }
        }

        # Per fold rows for export
        systems = [
            ("Frozen V3 Visual", "-", np.nan, 0.0, v3_held),
            ("LC Selection-Optimal", best_sel_row["config_id"], best_sel_row["lambda"], best_sel_row["lambda"], m_sel),
            ("LC Visual-Optimal", best_vis_row["config_id"], best_vis_row["lambda"], best_vis_row["lambda"], m_vis),
            ("LC Balanced-Optimal", best_bal_row["config_id"], best_bal_row["lambda"], best_bal_row["lambda"], m_bal),
            ("Label-Only Baseline", best_sel_row["config_id"], np.nan, np.inf, m_lo),
            ("ORACLE Ceiling (lam=0.5)", "oracle_gt", np.nan, 0.5, m_oracle_05),
            ("ORACLE Label-Only", "oracle_gt", np.nan, np.inf, m_oracle_lo)
        ]

        for sys_name, cfg_id, param_lam, eff_lam, met in systems:
            per_fold_comparison_rows.append({
                "fold": test_fold,
                "system": sys_name,
                "config_id": cfg_id,
                "lambda": eff_lam,
                "Class P@10": met["Class P@10"],
                "ML P@10": met["ML P@10"],
                "ML mAP": met["ML mAP"],
                "nDCG@10": met["nDCG@10"],
                "selection_score": met["selection_score"],
                "delta_selection_vs_v3": met["selection_score"] - v3_held["selection_score"],
                "delta_class_p10_vs_v3": met["Class P@10"] - v3_held["Class P@10"]
            })

    # Save selected_parameters.json and per_fold_results.csv
    (out_dir / "selected_parameters.json").write_text(json.dumps(lofo_selections, indent=2))
    df_per_fold = pd.DataFrame(per_fold_comparison_rows)
    df_per_fold.to_csv(out_dir / "per_fold_results.csv", index=False)
    print(f"Saved selected parameters to: {out_dir / 'selected_parameters.json'}")
    print(f"Saved per-fold comparison to: {out_dir / 'per_fold_results.csv'}")

    # 5. Build Aggregated Summary Table for Systems
    print("\n" + "=" * 110)
    print("LOFO EVALUATION SUMMARY TABLE ACROSS 5 HELD-OUT FOLDS")
    print("=" * 110)
    sys_summary = df_per_fold.groupby("system").agg(
        class_mean=("Class P@10", "mean"),
        class_std=("Class P@10", "std"),
        ml_map_mean=("ML mAP", "mean"),
        ml_map_std=("ML mAP", "std"),
        ml_p10_mean=("ML P@10", "mean"),
        ml_p10_std=("ML P@10", "std"),
        ndcg_mean=("nDCG@10", "mean"),
        ndcg_std=("nDCG@10", "std"),
        sel_mean=("selection_score", "mean"),
        sel_std=("selection_score", "std"),
        delta_sel=("delta_selection_vs_v3", "mean"),
        delta_cls=("delta_class_p10_vs_v3", "mean")
    ).reset_index()

    sys_order = [
        "Frozen V3 Visual",
        "LC Visual-Optimal",
        "LC Balanced-Optimal",
        "LC Selection-Optimal",
        "Label-Only Baseline",
        "ORACLE Ceiling (lam=0.5)",
        "ORACLE Label-Only"
    ]
    sys_summary["order"] = sys_summary["system"].apply(lambda s: sys_order.index(s) if s in sys_order else 99)
    sys_summary = sys_summary.sort_values("order").drop(columns=["order"])

    print(f"{'System':<26} {'Class P@10':<18} {'ML mAP':<18} {'Selection Score':<18} {'Delta Sel vs V3':<16}")
    print("-" * 110)
    for _, r in sys_summary.iterrows():
        print(f"{r['system']:<26} "
              f"{r['class_mean']:.4f} +/- {r['class_std']:.4f}  "
              f"{r['ml_map_mean']:.4f} +/- {r['ml_map_std']:.4f}  "
              f"{r['sel_mean']:.4f} +/- {r['sel_std']:.4f}  "
              f"{r['delta_sel']:+.4f}")
    print("=" * 110)

    # 6. Generate 100% Dynamic Markdown Summary (No Hardcoded Numbers)
    print("\n[Step 5] Generating label_context_v2_summary.md dynamically from result DataFrames...")

    md_sys_rows = []
    for _, r in sys_summary.iterrows():
        md_sys_rows.append(
            f"| **{r['system']}** | {r['class_mean']:.4f} $\\pm$ {r['class_std']:.4f} | "
            f"{r['ml_p10_mean']:.4f} $\\pm$ {r['ml_p10_std']:.4f} | "
            f"{r['ml_map_mean']:.4f} $\\pm$ {r['ml_map_std']:.4f} | "
            f"{r['ndcg_mean']:.4f} $\\pm$ {r['ndcg_std']:.4f} | "
            f"**{r['sel_mean']:.4f} $\\pm$ {r['sel_std']:.4f}** | "
            f"{r['delta_sel']:+.4f} |"
        )
    md_sys_table = "\n".join(md_sys_rows)

    pf_v3 = df_per_fold[df_per_fold["system"] == "Frozen V3 Visual"].set_index("fold")
    pf_sel = df_per_fold[df_per_fold["system"] == "LC Selection-Optimal"].set_index("fold")
    pf_bal = df_per_fold[df_per_fold["system"] == "LC Balanced-Optimal"].set_index("fold")

    md_pf_rows = []
    for f in range(1, 6):
        v_sel = pf_v3.loc[f, "selection_score"]
        s_sel = pf_sel.loc[f, "selection_score"]
        d_sel = pf_sel.loc[f, "delta_selection_vs_v3"]
        v_cls = pf_v3.loc[f, "Class P@10"]
        b_cls = pf_bal.loc[f, "Class P@10"]
        d_cls = pf_bal.loc[f, "delta_class_p10_vs_v3"]
        b_sel = pf_bal.loc[f, "selection_score"]
        d_bsel = pf_bal.loc[f, "delta_selection_vs_v3"]

        cfg_sel = lofo_selections["fold_results"][f"fold_{f}"]["strategy_sel_optimal"]
        cfg_bal = lofo_selections["fold_results"][f"fold_{f}"]["strategy_balanced_optimal"]

        md_pf_rows.append(
            f"| **Fold {f}** | {v_sel:.4f} | "
            f"`{cfg_sel['config_id']}` ($\\lambda={cfg_sel['lambda']:.2f}$) | {s_sel:.4f} (**{d_sel:+.4f}**) | "
